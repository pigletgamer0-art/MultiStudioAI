+
+/* Chat-like mobile redesign */
+:root{--bg:#000;--panel:#202020;--panel2:#2b2b2b;--line:#373737;--text:#f7f7f7;--muted:#a8a8a8;--accent:#2f7cf6;--accent2:#4d9cff;--shadow:none}
+html,body{background:#000;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
+.app{background:#000;height:100dvh}
+.topbar{height:78px;padding:calc(env(safe-area-inset-top) + 8px) 22px 8px;border:0;background:#000;display:grid;grid-template-columns:58px 1fr 58px;gap:16px;align-items:center}
+.topbar .icon{width:58px;height:58px;border-radius:50%;border:1px solid #404040;background:#242424;font-size:25px;box-shadow:none}
+.mode-switch{height:58px;max-width:330px;width:100%;justify-self:center;display:grid;grid-template-columns:1fr 1fr;background:#4a4a4a;border-radius:30px;padding:7px;gap:4px}
+.mode-switch button{border:0;border-radius:24px;background:transparent;color:#fff;font-size:18px;padding:0 18px}
+.mode-switch button.active{background:#252525}
+#modelChip{display:none}.logo,.brand{display:none}
+.views{background:#000}
+.chat-scroll{padding:14px 20px 165px;background:#000}
+.hero{border:0;background:transparent;box-shadow:none;padding:0;margin:0;max-width:100%;min-height:calc(100dvh - 270px);display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start}
+.hero .pill,.hero h1,.hero p{display:none}
+.quick{display:flex;flex-direction:column;gap:10px;margin:0 0 12px;width:100%;max-width:760px}
+.quick button{border:0;background:transparent;color:#c9c9c9;padding:5px 4px;text-align:left;font-size:16px}
+.quick button::before{content:'✦ ';opacity:.85}
+.messages{max-width:760px;width:100%}
+.msg{margin:20px 0;gap:12px}.avatar{display:none}.bubble{max-width:92%;border:0;background:transparent;padding:0;font-size:16px;line-height:1.55}.msg.user{justify-content:flex-end}.msg.user .bubble{background:#242424;border:1px solid #323232;border-radius:20px;padding:12px 16px}.msg-actions button{background:#202020}
+.composer-wrap{padding:8px 18px calc(18px + env(safe-area-inset-bottom));background:linear-gradient(transparent,#000 26%,#000 100%)}
+.composer-box{max-width:760px}
+.attachments{margin:0 0 8px 5px}
+.composer{min-height:72px;align-items:center;background:#242424;border:1px solid #424242;border-radius:36px;padding:8px 10px 8px 12px;gap:7px;box-shadow:none}
+.composer textarea{min-height:48px;max-height:160px;padding:13px 7px;font-size:17px;color:#fff}
+.composer textarea::placeholder{color:#aaa}
+.tool-btn{width:48px;height:48px;border-radius:50%;background:transparent;font-size:28px;padding:0}
